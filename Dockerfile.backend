ARG DOCKER_REGISTRY=docker.io
ARG PYPI_INDEX_URL=https://pypi.org/simple
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=

FROM ${DOCKER_REGISTRY}/python:3.12-slim AS builder
ARG PYPI_INDEX_URL
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} \
    http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN pip config set global.disable-pip-version-check true && \
    pip config set global.index-url "${PYPI_INDEX_URL}"

COPY backend /app/backend

RUN python3 -m venv /app/venv && \
    . /app/venv/bin/activate && \
    pip install --no-cache-dir /app/backend/

FROM ${DOCKER_REGISTRY}/python:3.12-slim

WORKDIR /app

COPY --from=builder /app/venv /app/venv
COPY --from=builder /app/backend /app/backend

EXPOSE 8000

ENTRYPOINT ["/bin/bash", "-c"]
CMD [". /app/venv/bin/activate && cd /app/backend && alembic upgrade head && python -m scripts.seed && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
